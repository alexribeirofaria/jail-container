{
  "name": "Ai Assistants",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  //"postCreateCommand": "",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "alefragnani.bookmarks@14.1.1",
        "alexiv.vscode-angular2-files@1.6.4",
        "anseki.vscode-color@0.4.5",
        "baflo.jasminesnippetsts@1.3.0",
        "bierner.emojisense@0.10.0",
        "bierner.markdown-checkbox@0.4.0",
        "blackboxapp.blackbox@2.8.53",
        "blackboxapp.blackboxagent@3.7.0",
        "dbaeumer.vscode-eslint@3.0.24",
        "dskwrk.vscode-generate-getter-setter@0.5.0",
        "dzhavat.bracket-pair-toggler@0.0.3",
        "hardikpthv.ngrxsnippets@9.1.0",
        "ibm.output-colorizer@0.1.2",
        "inferrinizzard.prettier-sql-vscode@1.6.0",
        "infinity1207.angular2-switcher@0.4.0",
        "john-crowson.angular-file-changer@0.0.4",
        "mathematic.vscode-pdf@0.1.11",
        "mattpocock.ts-error-translator@0.10.1",
        "ms-vscode.vscode-typescript-next@6.0.20260416",
        "natewallace.angular2-inline@0.0.17",
        "naumovs.color-highlight@2.8.0",
        "oderwat.indent-rainbow@8.3.1",
        "pkosta2006.rxjs-snippets@0.0.2",
        "shd101wyy.markdown-preview-enhanced@0.8.30",
        "typescriptteam.native-preview@0.20260611.2",
        "visualstudioexptteam.intellicode-api-usage-examples@0.2.9",
        "visualstudioexptteam.vscodeintellicode@1.3.2",
        "yzhang.markdown-all-in-one@3.6.3"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.inlineSuggest.enabled": false,
        "intellicode.suggestSelectionType": true,
        "editor.codeActions.triggerOnFocusChange": false,
        "editor.lightbulb.enabled": "onCode",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.detectIndentation": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.prettier": "always",
          "source.fixAll.eslint": "always",
          "source.organizeImports": "always"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[typescript]": {
          "editor.defaultFormatter": "vscode.typescript-language-features"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[html]": {
          "editor.defaultFormatter": "vscode.html-language-features"
        },
        "[json]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        },
        "[scss]": {
          "editor.defaultFormatter": "vscode.css-language-features"
        },
        "eslint.enable": true,
        "eslint.run": "onType",
        "eslint.validate": [
          "typescript",
          "javascript",
          "html",
          "scss"
        ],
        "eslint.workingDirectories": [
          "backend",
          "frontend"
        ],
        "indentRainbow.includedLanguages": [],
        "indentRainbow.updateDelay": 100,
        "js/ts.updateImportsOnFileMove.enabled": "always",
        "js/ts.suggest.autoImports": true,
        "prettier.requireConfig": false,
        "explorer.compactFolders": false,
        "auto-rename-tag.activationOnLanguage": [
          "html",
          "xml",
          "scss",
          "javascript",
          "typescript",
          "json"
        ],
        "angular.enable-strict-mode-prompt": false,
        "angular2-switcher.openSideBySide": true,
        "angular2-switcher.templateFormats": [
          ".html"
        ],
        "angular2-switcher.styleFormats": [
          ".spec.ts",
          ".stories.ts"
        ],
        "[jsonc]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        }
      }
    }
  }
}
